{
  "name": "hitbox-admin-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:gating": "tsx scripts/verify-gating.ts",
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/build-icons.mjs",
    "e2e": "playwright test --project=public-chromium --project=public-mobile",
    "e2e:all": "playwright test --project=public-chromium --project=public-mobile --project=authed-chromium --project=authed-mobile",
    "e2e:public": "playwright test --project=public-chromium --project=public-mobile",
    "e2e:authed": "playwright test --project=authed-chromium --project=authed-mobile",
    "e2e:login": "playwright test --project=auth-capture --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/.report",
    "docs:pdf": "node scripts/docs-to-pdf.mjs",
    "docs:api-cases": "node scripts/api-test-cases.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@clerk/themes": "^2.4.57",
